        </tbody>
    </table>

<script>
function Dadojaurtiketa() {
    return Math.floor(Math.random() * 6) + 1;
}

function Dadojaurtiketa() {

    const ezaugarriak = [
        "Sendotasuna", "Trebezia", "Bizkortasuna", "Hautematea",
        "Boterea", "Adimena", "Karisma"
    ];

    const tabla = document.getElementById("Emaitzataula");
    tabla.innerHTML = "";

    for (let i = 0; i < 7; i++) {

        let dado1 = jaurtidadoa();
        let dado2 = jaurtidadoa();
        let dado3 = jaurtidadoa();
        let total = dado1 + dado2 + dado3;

        let fila = `
            <tr>
                <td>${ezaugarriak[i]}</td>
                <td>${dado1}</td>
                <td>${dado2}</td>
                <td>${dado3}</td>
